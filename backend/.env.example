REDIS_URL=redis://localhost:6379/0
FLASK_ENV=development  # Set to 'production' in production. Requires REDIS_URL to be set.
ALLOW_SEED=1           # Set to 1 in dev to allow DB seeding

# Note: JWT access tokens expire in 15m, refresh tokens in 7d.
# The login response shape returns: { "access_token": "...", "refresh_token": "...", "user": {...} }
